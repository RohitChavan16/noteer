# Noteer Environment Variables Example
# Copy this file to .env and fill in your values
# See README.md for full documentation

# === REQUIRED ===
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# === OPTIONAL ===

# Application port (default: 3000)
PORT=3000

# Max stored versions per note (default: 10, FIFO rotation)
NOTE_VERSION_LIMIT=10

# Allow new user registration (default: true)
REGISTRATION_ENABLED=true

# === SSL (for direct HTTPS without reverse proxy) ===
# SSL_ENABLED=false
# SSL_CERT_PATH=/certs/cert.pem
# SSL_KEY_PATH=/certs/key.pem

# === REVERSE PROXY ===
# Trust proxy for correct IP detection behind load balancers
# Number: hops to trust (1 = single proxy like Nginx/Traefik)
# String: 'loopback', 'linklocal', or CIDR like '10.0.0.0/8'
# TRUST_PROXY=1
