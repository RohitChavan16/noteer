# Backend Environment Variables
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://noteer:noteer@localhost:5432/noteer

# JWT (Optional - auto-generated if not set)
# JWT_SECRET=your-secure-random-string

# Registration (set to false to disable new user registrations)
REGISTRATION_ENABLED=true

# OIDC (Optional)
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback

# SSL (Optional - for direct HTTPS without reverse proxy)
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Admin user (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
